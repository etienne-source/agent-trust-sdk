{
  "name": "@trustflow/sdk",
  "version": "0.1.0",
  "description": "Trustflow domain identity verification SDK (@trustflow/sdk). Install from github:etienne-source/agent-trust-sdk. The public npm package trustflow-sdk is an unrelated logging package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-source/agent-trust-sdk.git"
  },
  "homepage": "https://github.com/etienne-source/agent-trust-sdk#readme",
  "bugs": {
    "url": "https://github.com/etienne-source/agent-trust-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "agents",
    "did",
    "did:web",
    "verification",
    "mcp",
    "trust",
    "trustflow",
    "llms.txt"
  ]
}
