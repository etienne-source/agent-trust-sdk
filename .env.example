# SDK fallback when local did:web is unavailable (GET /v1/verify?domain=).
# agenticTrustMiddleware uses AGENTIC_TRUST_API_URL, then this value,
# then https://api.trustflow.systems. Timeout default is 4000ms.
# Hosted Trustflow Systems registry:
VERIFICATION_API_URL=https://api.trustflow.systems
# AGENTIC_TRUST_API_URL=https://api.trustflow.systems

# CLI registration (POST /v1/register and POST /v1/register/confirm).
# Defaults to https://api.trustflow.systems when unset.
# TRUSTFLOW_API_URL=https://api.trustflow.systems
# https://trustflow.systems/api/register is an alias of that origin.

# GitHub Action (repository settings, not this file):
# secret  AGENTIC_TRUST_PRIVATE_KEY   RSA PEM, never commit or print
# var     AGENTIC_TRUST_DOMAIN
# var     AGENTIC_TRUST_BUSINESS_NAME

# Optional in-memory cache settings (SDK defaults: TTL 3600000ms / 1h, max 1000 entries)
# CACHE_TTL_MS=3600000
# CACHE_MAX_ENTRIES=1000
