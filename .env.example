# SDK fallback when local did:web is unavailable (GET /v1/verify?domain=).
# agenticTrustMiddleware uses AGENTIC_TRUST_API_URL, then this value,
# then https://api.trustflow.systems. Timeout default is 4000ms.
# Hosted Trustflow Systems registry:
VERIFICATION_API_URL=https://api.trustflow.systems
# AGENTIC_TRUST_API_URL=https://api.trustflow.systems

# CLI registration (POST /v1/register and POST /v1/register/confirm).
# Defaults to https://api.trustflow.systems when unset. Requests abort after 20s.
# TRUSTFLOW_API_URL=https://api.trustflow.systems
# TRUSTFLOW_API_TIMEOUT_MS=20000
# https://trustflow.systems/api/register is an alias of that origin.

# GitHub Action (repository settings, not this file):
# secret  AGENTIC_TRUST_PRIVATE_KEY   Ed25519 or P-256 PEM, never commit or print
# var     AGENTIC_TRUST_DOMAIN
# var     AGENTIC_TRUST_BUSINESS_NAME

# Optional verify cache. Warm in-memory hits stay under 5ms.
# AGENTIC_TRUST_CACHE_DIR is an optional disk copy of public verify results. Never put a private key there.
# CACHE_TTL_MS=3600000
# CACHE_MAX_ENTRIES=1000
# AGENTIC_TRUST_CACHE_DIR=.agentic-trust/verify-cache

# Vercel / Next build hook (@trustflow/vercel-plugin). Set these in the host UI, not in git.
# secret  AGENTIC_TRUST_PRIVATE_KEY
# var     AGENTIC_TRUST_DOMAIN
# var     AGENTIC_TRUST_BUSINESS_NAME

# scripts/submit-ecosystem-prs.mjs --apply (fork + pull request). Dry-run does not read this.
# A classic or fine-grained PAT that can create a fork and open a pull request on allowlisted repos.
# Never commit the token. The script does not search GitHub and does not post to X.
# GITHUB_TOKEN=

# Optional webhook when a caller reports a domain at 100/100 VERIFIED.
# notifyVerifiedDomain POSTs JSON to this URL. It does not post to X.
# Sharing on X is a separate explicit step.
# VERIFIED_NOTIFY_WEBHOOK=https://example.com/hooks/agentic-trust
