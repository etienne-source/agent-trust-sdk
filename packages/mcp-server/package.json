{
  "name": "@trustflow/mcp-server",
  "version": "1.0.1",
  "description": "AgenticTrust MCP server. Stdio tools for Trustflow Systems domain audits, did:web keys, and signed llms.txt. Binary: agentic-trust-mcp. Scaffold with npx @trustflow/cli@latest init.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-source/agent-trust-sdk.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/etienne-source/agent-trust-sdk#readme",
  "bugs": {
    "url": "https://github.com/etienne-source/agent-trust-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agentic-trust-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trustflow/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agentictrust",
    "agentic-trust",
    "mcp",
    "did",
    "did:web",
    "trustflow",
    "llms.txt"
  ]
}
