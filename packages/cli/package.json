{
  "name": "@trustflow/cli",
  "version": "1.0.0",
  "description": "AgenticTrust CLI. Scaffold llms.txt, sign a did:web key, and register the domain with Trustflow Systems. Binary: trustflow (alias: agentic-trust).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-source/agent-trust-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/etienne-source/agent-trust-sdk#readme",
  "bugs": {
    "url": "https://github.com/etienne-source/agent-trust-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "trustflow": "./dist/cli.js",
    "agentic-trust": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trustflow/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agentictrust",
    "agentic-trust",
    "cli",
    "did",
    "did:web",
    "trustflow",
    "llms.txt"
  ]
}
