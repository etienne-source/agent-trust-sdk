{
  "name": "@agentic-trust/vercel-plugin",
  "version": "0.1.0",
  "description": "AgenticTrust Vercel build hook. Signs did:web and llms.txt from environment secrets during deploy, with no interactive CLI. Not on npm yet — install from github:etienne-source/agent-trust-sdk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-source/agent-trust-sdk.git",
    "directory": "packages/vercel-plugin"
  },
  "homepage": "https://github.com/etienne-source/agent-trust-sdk#readme",
  "bugs": {
    "url": "https://github.com/etienne-source/agent-trust-sdk/issues"
  },
  "type": "module",
  "bin": {
    "agentic-trust-vercel": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentic-trust/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agentictrust",
    "agentic-trust",
    "vercel",
    "next",
    "did",
    "did:web",
    "llms.txt"
  ]
}
