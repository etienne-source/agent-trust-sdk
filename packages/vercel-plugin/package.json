{
  "name": "@trustflow/vercel-plugin",
  "version": "1.0.2",
  "description": "Trustflow Vercel build hook. Signs did:web and llms.txt from environment secrets during deploy, with no interactive CLI. Scaffold with npx @trustflow/cli@latest init.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/etienne-source/agent-trust-sdk.git",
    "directory": "packages/vercel-plugin"
  },
  "homepage": "https://github.com/etienne-source/agent-trust-sdk#readme",
  "bugs": {
    "url": "https://github.com/etienne-source/agent-trust-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agentic-trust-vercel": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@trustflow/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "trustflow",
    "vercel",
    "next",
    "did",
    "did:web",
    "llms.txt"
  ]
}
